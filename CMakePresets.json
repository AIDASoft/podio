{
    "version": 3,
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_FLAGS": " -fdiagnostics-color=always ",
                "PODIO_USE_CLANG_FORMAT": "OFF",
                "PODIO_SET_RPATH": "ON",
                "PODIO_ENABLE_SCHEMA_EVOLUTION_TESTS": "OFF"
            },
            "installDir": "${sourceDir}/install"
        },
        {
            "name": "base-build",
            "displayName": "Base Build including RNTuple backend and DataSource",
            "inherits": "common",
            "generator": "Ninja",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "ENABLE_RNTUPLE": "ON",
                "ENABLE_DATASOURCE": "ON",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
            }
        },
        {
            "name": "full-build",
            "displayName": "Full build including schema evolution tests, SIO, Arrow and Parquet",
            "inherits": "base-build",
            "cacheVariables": {
                "ENABLE_SIO": "ON",
                "ENABLE_ARROW": "ON",
                "ENABLE_PARQUET": "ON",
                "PODIO_ENABLE_SCHEMA_EVOLUTION_TESTS": "ON"
            }
        },
        {
            "name": "ci-build",
            "displayName": "Full build with warnings as errors",
            "inherits": "full-build",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": " -fdiagnostics-color=always -Werror -Wno-error=deprecated-declarations",
                "PODIO_USE_CLANG_FORMAT": "AUTO"
            }
        },
        {
            "name": "ci-build-no-root",
            "displayName": "Full build with warnings as errors, without ROOT and python bindings",
            "inherits": "ci-build",
            "cacheVariables": {
                "ENABLE_ROOT": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ci-base",
            "hidden": true,
            "nativeToolOptions": ["-k0"]
        },
        {
            "name": "ci-build",
            "displayName": "Building like on CI",
            "inherits": "ci-base",
            "configurePreset": "ci-build"
        },
        {
            "name": "ci-build-no-root",
            "displayName": "Building like on CI, without ROOT",
            "inherits": "ci-base",
            "configurePreset": "ci-build-no-root"
        }
    ],
    "testPresets": [
        {
            "name": "ci-base",
            "hidden": true,
            "execution": {
                "stopOnFailure": false,
                "scheduleRandom": true,
                "timeout": 600
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ci-build",
            "displayName": "Testing like on CI",
            "inherits": "ci-base",
            "configurePreset": "ci-build"
        },
        {
            "name": "ci-build-no-root",
            "displayName": "Testing like on CI, without ROOT",
            "inherits": "ci-base",
            "configurePreset": "ci-build-no-root"
        }
    ]
}
