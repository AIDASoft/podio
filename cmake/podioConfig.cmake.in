###############################################################################
# PODIO CMAKE CONFIG
#
# Exported Targets
#
# Always available:
#  podio::podio             Core podio library (Frame, GenericParameters,
#                           UserDataCollection, ...) without any I/O backend
#  podio::podioIO           Generic podio::Reader and podio::Writer
#                           interfaces. Links all enabled I/O backend libraries
#                           (podioRootIO, podioSioIO, podioArrow)
#  podio::podio-dump-tool   Executable backing the podio-dump script
#  podio::podio-test-hashes Executable to check for collision of hashes
#
# Only if podio has been built with ROOT support (PODIO_ENABLE_ROOT):
#  podio::podioDict         ROOT dictionary for the core podio classes
#  podio::podioRootIO       ROOT I/O backend (ROOTReader, ROOTWriter,
#                           ROOTLegacyReader) and, if podio has been built
#                           with RNTuple support, also RNTupleReader and
#                           RNTupleWriter
#  podio::podioRootIODict   ROOT dictionary for the ROOT I/O classes
#
# Only if podio has been built with the ROOT DataSource (ENABLE_DATASOURCE):
#  podio::podioDataSource      ROOT RDataFrame DataSource for podio files
#  podio::podioDataSourceDict  ROOT dictionary for the DataSource
#
# Only if podio has been built with SIO support (PODIO_ENABLE_SIO):
#  podio::podioSioIO        SIO I/O backend (SIOReader, SIOWriter,
#                           SIOLegacyReader)
#  podio::podioSioIODict    ROOT dictionary for the SIO I/O classes (only if
#                           podio has also been built with ROOT support)
#
# Only if podio has been built with Arrow support (PODIO_ENABLE_ARROW):
#  podio::podioArrow        Arrow conversion functionality and, if podio has
#                           been built with Parquet support
#                           (PODIO_ENABLE_PARQUET), the ArrowReader and
#                           ArrowWriter for Parquet files
#  podio::podioArrowDict    ROOT dictionary for the Arrow I/O classes (only
#                           if podio has been built with Parquet and ROOT
#                           support)
#
# Variables
#
#  podio_VERSION            The version of podio
#  podio_INCLUDE_DIR        The podio include directory
#  podio_LIBRARY_DIR        The podio library directory
#  podio_PYTHON_DIR         The directory containing the podio python
#                           modules (and the code generator)
#  PODIO_IO_HANDLERS        List of available I/O backends (ROOT, SIO, ARROW)
#  PODIO_ENABLE_ROOT        Whether podio has been built with ROOT support
#  PODIO_ENABLE_SIO         Whether podio has been built with SIO support
#  PODIO_ENABLE_ARROW       Whether podio has been built with Arrow support
#  PODIO_ENABLE_PARQUET     Whether podio has been built with Parquet support
#                           (implies PODIO_ENABLE_ARROW)
#  PODIO_ARROW_TARGET       The Arrow target podio links against (only set if
#                           PODIO_ENABLE_ARROW)
#
# Macros: see podioMacros.cmake for complete documentation
#
#  PODIO_GENERATE_DATAMODEL     Generate the code for a datamodel from a YAML
#                               definition
#  PODIO_ADD_DATAMODEL_CORE_LIB Create the core library for a generated
#                               datamodel
#  PODIO_ADD_ROOT_IO_DICT       Create the ROOT dictionary for a generated
#                               datamodel (no-op without ROOT support)
#  PODIO_ADD_SIO_IO_BLOCKS      Create the SIO blocks library for a generated
#                               datamodel (no-op without SIO support)
#  PODIO_ADD_ARROW              Create the Arrow library for a generated
#                               datamodel (no-op without Arrow support)
#  PODIO_GENERATE_DICTIONARY    Generate a ROOT dictionary (wrapper around
#                               REFLEX_GENERATE_DICTIONARY, requires ROOT)
#
###############################################################################
@PACKAGE_INIT@

set_and_check(podio_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(podio_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set_and_check(podio_PYTHON_DIR "@PACKAGE_podio_PYTHON_INSTALLDIR@")
set(PODIO_IO_HANDLERS "@PODIO_IO_HANDLERS@")

include(CMakeFindDependencyMacro)

SET(PODIO_ENABLE_ROOT @ENABLE_ROOT@)
if(PODIO_ENABLE_ROOT)
  find_dependency(ROOT @ROOT_VERSION@)
endif()
find_dependency(Threads)
if(NOT "@REQUIRE_PYTHON_VERSION@" STREQUAL "")
  find_dependency(Python3 @REQUIRE_PYTHON_VERSION@ COMPONENTS Interpreter Development)
else()
  find_dependency(Python3 COMPONENTS Interpreter Development)
endif()

SET(PODIO_ENABLE_SIO @ENABLE_SIO@)
if(PODIO_ENABLE_SIO)
  find_dependency(SIO)
  # Targets from SIO only become available with v00-01 so we rig them here to be
  # able to use them
  if (SIO_VERSION VERSION_LESS 0.1)
    message(STATUS "Found SIO without Targets, creating them on the fly")
    add_library(SIO::sio SHARED IMPORTED)
    set_target_properties(SIO::sio PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES ${SIO_INCLUDE_DIRS}
      INTERFACE_LINK_LIBRARIES ${SIO_LIBRARIES}
      IMPORTED_LOCATION ${SIO_LIBRARIES})
  endif()
endif()

SET(PODIO_ENABLE_ARROW @ENABLE_ARROW@)
SET(PODIO_ENABLE_PARQUET @ENABLE_PARQUET@)
if(PODIO_ENABLE_ARROW)
  set(lz4Alt_FIND_QUIETLY TRUE)
  set(zstdAlt_FIND_QUIETLY TRUE)
  find_dependency(Arrow @Arrow_VERSION@)
  if(PODIO_ENABLE_PARQUET)
    find_dependency(nlohmann_json @nlohmann_json_VERSION@)
    find_dependency(Parquet @Parquet_VERSION@)
  endif()
  set(PODIO_ARROW_TARGET @PODIO_ARROW_TARGET@)
endif()

if(NOT TARGET podio::podio)
  include("${CMAKE_CURRENT_LIST_DIR}/podioTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/podioMacros.cmake")
endif()

check_required_components(podio)

# Print the default "Found" message and check library location
include(FindPackageHandleStandardArgs)
get_property(TEST_PODIO_LIBRARY TARGET podio::podio PROPERTY LOCATION)
set(podio_VERSION "@podio_VERSION@")
find_package_handle_standard_args(podio
  REQUIRED_VARS CMAKE_CURRENT_LIST_FILE TEST_PODIO_LIBRARY
  VERSION_VAR podio_VERSION
)
